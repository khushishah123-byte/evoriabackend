# Firebase Configuration
# Get these from your Firebase project console
# https://console.firebase.google.com/project/{PROJECT_ID}/settings/serviceaccounts/adminsdk

# Option 1: Pass entire Firebase credentials as JSON string (recommended for production)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"evoria-5f339",...}

# Option 2: Pass path to Firebase credentials JSON file (for development)
# FIREBASE_KEY_PATH=./firebase-adminsdk-key.json

# Server Configuration
PORT=3000

# JWT Configuration (deprecated - Firebase handles auth now, but keep for reference)
ACCESS_TOKEN_EXPIRY=1d
ACCESS_TOKEN_SECRET=your-secret-key-here
REFRESH_TOKEN_EXPIRY=10d
REFRESH_TOKEN_SECRET=your-refresh-secret-here

# Google API Key (for Generative AI)
GAPI_KEY=your-google-api-key-here

# Cloudinary Configuration (for file uploads)
api_key=your-cloudinary-api-key
api_secret=your-cloudinary-api-secret
cloud_name=your-cloudinary-cloud-name

# Database Configuration (no longer needed - Firebase replaces this)
# MONGODB_URI=

# Notes:
# 1. Firebase handles authentication, no need for custom JWT tokens
# 2. All user passwords are managed by Firebase Authentication
# 3. Files can be stored in Firestore or Firebase Storage
# 4. API structure remains the same for backward compatibility
